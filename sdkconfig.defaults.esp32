# Extra defaults for classic ESP32 boards only (ESP-IDF loads sdkconfig.defaults.<target> after
# sdkconfig.defaults). The ESP32 has little IRAM, and with BLE + WiFi + the WS2812 (RMT) LED driver
# the M5Stack Atom Echo overflowed iram0 by ~1.5 KB. Nothing here uses RMT receive or SPI slave,
# and the RMT only drives the status LED, so its handlers don't need to live in IRAM.
# CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_RMT_ENCODER_FUNC_IN_IRAM is not set
# CONFIG_SPI_SLAVE_ISR_IN_IRAM is not set
# ESP-IDF 5.5.2 needs a little more IRAM than 5.5.0 (~100 bytes over with the above). This only moves
# the ringbuffer functions that ISRs never call; BLE OTA tested fine with it.
# Don't turn off CONFIG_ESP_WIFI_RX_IRAM_OPT to save IRAM: with BT coexistence the BT controller calls
# into that code while the flash is busy, so BLE OTA dropped the link (HCI 0x08) as soon as it erased
# or wrote flash.
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
